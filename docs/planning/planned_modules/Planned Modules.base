filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("planning/planned_modules")'
    - 'file.name != "README.md"'

properties:
  status:
    displayName: Status
  updated:
    displayName: Updated
  tags:
    displayName: Tags

views:
  - type: table
    name: "Timeline"
    order:
      - file.name
      - title
      - status
      - updated

  - type: table
    name: "By Status"
    order:
      - file.name
      - title
      - updated
    groupBy:
      property: status
      direction: ASC
