{
  "name": "guest-form-management",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "ui"
  ],
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/dev/dedupe-react-types.mjs",
    "prepare": "husky",
    "lint": "cd ui && bun run lint",
    "lint:fix": "cd ui && bun run lint:fix",
    "check:filenames": "./scripts/dev/check-ui-filename-conventions.sh",
    "check:ai-tooling-sync": "bash scripts/dev/check-ai-tooling-sync.sh",
    "check:workflow-scratchpads": "bash scripts/dev/check-workflow-scratchpads.sh",
    "sync:workflow-scratchpads": "bash scripts/dev/sync-workflow-scratchpads.sh",
    "setup:ai-tooling": "bash scripts/dev/setup-ai-tooling.sh",
    "cleanup:claude-mem": "bash scripts/dev/cleanup-claude-mem.sh",
    "setup:agents-skills": "bash scripts/dev/setup-agents-skills.sh",
    "setup:impeccable": "bash scripts/dev/setup-impeccable.sh",
    "setup:playwright-cli": "bash scripts/dev/setup-playwright-cli.sh",
    "setup:design-md": "bash scripts/dev/setup-design-md.sh",
    "type-check": "cd ui && bun run type-check",
    "ci:quality": "./scripts/dev/ci-quality-gate.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,mdc,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,mdc,css}\"",
    "preview:emails:db": "node scripts/preview/preview-emails-from-db.mjs",
    "preview:emails:serve": "cd supabase/functions/_shared/email-templates && python3 -m http.server 3334",
    "preview:emails": "bun run preview:emails:db && bun run preview:emails:serve",
    "dev": "./dev.sh",
    "dev:ui": "cd ui && bun run dev",
    "dev:api": "bash -c './scripts/dev/build-local-functions-env.sh >/dev/null && ./scripts/dev/bunx --bun supabase@latest functions serve --env-file ./supabase/.temp/functions-serve.env'",
    "dev:remote-api": "./scripts/dev/run-remote-functions-serve.sh",
    "start:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest start",
    "status:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest status",
    "stop:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest stop",
    "stop:supabase:clean": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest stop --no-backup --yes",
    "db:reset": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db reset",
    "db:migrate": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest migration up --local --include-all",
    "seed:mock-listings": "node scripts/dev/generate-mock-listings-seed.mjs",
    "sync:prod-data": "./scripts/data/sync-prod-public-data-to-local.sh",
    "sync:prod-data:restore": "RESTORE_ONLY=1 ./scripts/data/sync-prod-public-data-to-local.sh",
    "sync:ai-knowledge-base": "bun scripts/sync-ai-knowledge-base.ts",
    "sync:ai-knowledge-base:dev": "bun scripts/sync-ai-knowledge-base.ts --dev",
    "build:ui": "cd ui && bun run build",
    "build": "bun run build:ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:parking": "playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\"",
    "test:e2e:parking:headed": "playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\" --headed",
    "test:e2e:parking:side-by-side": "playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:side-by-side:slow": "PLAYWRIGHT_SLOW_MO=600 PLAYWRIGHT_DEMO_PAUSE_MS=2000 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:local": "PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium",
    "test:e2e:parking:local:headed": "PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium --headed",
    "test:e2e:parking:screens": "PLAYWRIGHT_CAPTURE_SCREENS=1 playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\" && PLAYWRIGHT_CAPTURE_SCREENS=1 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:screens:local": "PLAYWRIGHT_CAPTURE_SCREENS=1 PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium",
    "deploy:supabase": "./scripts/deploy/deploy-supabase.sh",
    "deploy:supabase:db": "./scripts/deploy/deploy-supabase.sh --db-only",
    "deploy:supabase:functions": "./scripts/deploy/deploy-supabase.sh --functions-only",
    "deploy:supabase:dev": "./scripts/deploy/deploy-supabase-dev.sh",
    "deploy:supabase:dev:db": "./scripts/deploy/deploy-supabase-dev.sh --db-only",
    "deploy:supabase:dev:functions": "./scripts/deploy/deploy-supabase-dev.sh --functions-only",
    "backup:supabase:dev": "./scripts/deploy/backup-supabase.sh dev",
    "backup:supabase:prod": "./scripts/deploy/backup-supabase.sh prod",
    "rollback:supabase:dev": "./scripts/deploy/rollback-supabase.sh dev",
    "rollback:supabase:prod": "./scripts/deploy/rollback-supabase.sh prod",
    "rollback:functions:dev": "./scripts/deploy/rollback-functions.sh dev",
    "rollback:functions:prod": "./scripts/deploy/rollback-functions.sh prod",
    "migrations:status:dev": "./scripts/deploy/migration-status.sh dev",
    "migrations:status:prod": "./scripts/deploy/migration-status.sh prod",
    "env:status": "./scripts/dev/check-linked-project.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.49.1",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "dependencies": {}
}
