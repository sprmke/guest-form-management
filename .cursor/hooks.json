{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-superpowers-opt-in.sh",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/session-ai-tooling-sync.sh",
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/session-workflow-in-progress.sh",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-edited-file.sh",
        "timeout": 15
      },
      {
        "command": "bash .cursor/hooks/check-stack-terminology.sh",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.sh",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "[ ! -f \"/Users/michaelmanlulu/.cursor/skills/impeccable/scripts/hook-before-edit.mjs\" ] || node \"/Users/michaelmanlulu/.cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/guard-shipped-migrations.sh",
        "matcher": "StrReplace",
        "timeout": 5
      }
    ]
  }
}
