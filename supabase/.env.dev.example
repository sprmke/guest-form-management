# =============================================================================
# Dev Supabase project — copy to supabase/.env.dev.local (gitignored)
# =============================================================================
#
# Used by:
#   bun run deploy:supabase:dev
#   bun run dev:remote-api
#
# NEVER commit real values. Keep dev project on a separate Supabase account.
# =============================================================================

# --- Dev project identity (required) ----------------------------------------
# MULTI_TENANT_DEV — dev/staging only (kame-homes Preview / develop URL). Prod = separate MULTI_TENANT_PROD project.
DEV_PROJECT_REF=replace-with-dev-project-ref
DEV_SUPABASE_URL=https://replace-with-dev-project-ref.supabase.co
DEV_SERVICE_ROLE_KEY=replace-with-dev-service-role-key-from-dashboard

# Safety: LEGACY live-users ref — deploy script refuses if DEV_PROJECT_REF matches.
# Copy the real ref from docs/architecture/deployment.md into .env.dev.local only.
# PROD_PROJECT_REF=replace-with-legacy-prod-project-ref

# Optional: dev Postgres connection string for ./scripts/deploy/rollback-supabase.sh dev
# (Dashboard → Connect → Session pooler URI). Never commit a real value.
# DEV_DB_URL=postgresql://postgres.[DEV_REF]:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# --- Edge function secrets (mirror into Dashboard → Edge Functions → Secrets)
ENVIRONMENT=development

ADMIN_ALLOWED_EMAILS=you@example.com

RESEND_API_KEY=re_replace_me
EMAIL_TO=dev-inbox@example.com
EMAIL_REPLY_TO=dev-inbox@example.com

# OAuth return origins when testing Gmail connect against dev from local Vite
# GMAIL_OAUTH_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PUBLIC_API_URL defaults to DEV_SUPABASE_URL for functions serve env merge
