# Dev project — copy to .env.dev.local
# Used by: bun run deploy:supabase:dev · bun run dev:remote-api

# Dev project
DEV_PROJECT_REF=replace-me
DEV_SUPABASE_URL=https://<ref>.supabase.co
DEV_SERVICE_ROLE_KEY=replace-me
# PROD_PROJECT_REF=legacy-live-ref-from-deployment.md
# DEV_DB_URL=postgresql://...

# Env
ENVIRONMENT=development

# Auth
ADMIN_ALLOWED_EMAILS=you@example.com
SUPER_ADMIN_EMAILS=you@example.com

# Email
RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=
# RESEND_INBOUND_WEBHOOK_SECRET=
# RESEND_APPROVAL_INBOUND_DOMAIN=

# Crypto
# GMAIL_OAUTH_TOKEN_ENCRYPTION_KEY=
# SETTINGS_VERIFICATION_SECRET=

# URLs
# PUBLIC_API_URL=https://<ref>.supabase.co

# Optional: AI · Meta · PayMongo · Jamendo · cron secrets — see .env.example
