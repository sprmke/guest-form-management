# =============================================================================
# Multi-tenant PROD Supabase — copy to supabase/.env.prod.local (gitignored)
# =============================================================================
#
# Used for manual mt-prod deploy bootstrap (Phase B — see docs/workflow/in-progress/
# ci-cd-environments/). NOT legacy live users.
#
# TEMPLATE ONLY — commit placeholders, never real secrets.
# Copy values from Supabase Dashboard → Settings → API after you create mt-prod.
# Project refs in operator docs are semi-public (they appear in browser URLs);
# keys/tokens/passwords must stay in gitignored *.local files or GitHub Secrets.
# =============================================================================

# --- Multi-tenant prod project (required) -----------------------------------
MT_PROD_PROJECT_REF=replace-with-mt-prod-project-ref
MT_PROD_SUPABASE_URL=https://replace-with-mt-prod-project-ref.supabase.co
MT_PROD_SERVICE_ROLE_KEY=replace-with-mt-prod-service-role-key-from-dashboard

# Deny-list: legacy live-users ref — copy from docs/architecture/deployment.md
# into your local file only; do not commit the real ref here.
LEGACY_PROD_PROJECT_REF=replace-with-legacy-prod-project-ref

# Optional: session pooler URI for rollback (Dashboard → Connect)
# MT_PROD_DB_URL=postgresql://postgres.[REF]:PASSWORD@....pooler.supabase.com:6543/postgres

# --- Edge function secrets (Dashboard → Edge Functions → Secrets) -----------
ENVIRONMENT=production

ADMIN_ALLOWED_EMAILS=you@example.com
SUPER_ADMIN_EMAILS=you@example.com

RESEND_API_KEY=re_replace_me
# RESEND_INBOUND_WEBHOOK_SECRET=whsec_replace_me
# RESEND_APPROVAL_INBOUND_DOMAIN=inbound.kamehomes.space
EMAIL_TO=prod-inbox@example.com
EMAIL_REPLY_TO=prod-inbox@example.com
