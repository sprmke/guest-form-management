# =============================================================================
# UI / Vite env vars — copy to `.env.development` and/or `.env.production`
# =============================================================================
#
# Vite resolves the file by build mode (`npm run dev` → `.env.development`,
# `npm run build` → `.env.production`). Only variables prefixed with `VITE_`
# are exposed to client code via `import.meta.env.VITE_*`.
#
# NEVER commit real values. All `.env*` files (except `*.example`) are git-ignored.
# Templates use placeholders only — copy real keys/refs into gitignored `.local` files.
#
# Env file map:
#   ui/.env.development          — primary local file (full-stack ./dev.sh default)
#   ui/.env.development.dev      — hosted dev Supabase (./dev.sh --ui-only --env dev)
#   ui/.env.development.local    — local stack ui-only (./dev.sh --ui-only --env local)
#   supabase/.env.dev.local      — dev project deploy + dev:remote-api
# See docs/archive/operations/dev-staging-environment.md
# =============================================================================


# --- Runtime mode ----------------------------------------------------------
# Consumed by `GuestForm.tsx`: when `production`, the form hides dev controls and
# hard-disables test-booking email delivery. Keep `development` locally even if the
# file points at the prod Supabase project (it often does — see below).
VITE_NODE_ENV=development


# --- Supabase project ------------------------------------------------------
# Supabase Edge Functions base URL (includes `/functions/v1` suffix).
# Example (local CLI):  http://127.0.0.1:54321/functions/v1
# Example (prod):       https://<project-ref>.supabase.co/functions/v1
VITE_SUPABASE_URL=https://<project-ref>.supabase.co/functions/v1

# Duplicate of `VITE_SUPABASE_URL` for historical reasons — both are read by the
# guest form fetchers (`VITE_API_URL`) and by `ui/src/lib/supabaseClient.ts`
# (`VITE_SUPABASE_URL`). Keep them in sync.
VITE_API_URL=https://<project-ref>.supabase.co/functions/v1

# Anon public key from Supabase dashboard → Project Settings → API.
# Safe to ship to the browser; it only grants access subject to RLS.
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-dashboard

# Optional override. If unset, `ui/src/lib/supabaseClient.ts` derives the project
# URL by stripping `/functions/v1` from VITE_SUPABASE_URL. Only set this when you
# want the Supabase JS client to talk to a different project than the functions.
# VITE_SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co


# --- Platform super-admin (UI UX gate only) ---------------------------------
# Comma-separated emails that see the Admin tab in the mode switcher and can
# open `/admin/*`. Server enforces `SUPER_ADMIN_EMAILS` on edge functions.
# VITE_SUPER_ADMIN_EMAILS=you@example.com


# --- Property settings: Google Maps location picker -------------------------
# Browser key for Maps JavaScript API + Places API (Property Settings → Location)
# and optional Maps Embed API (public property page map iframe).
# Restrict by HTTP referrer in Google Cloud. Enable:
#   - Maps JavaScript API
#   - Places API
#   - Maps Embed API (public /properties/:slug map; optional — legacy embed works without it)
# VITE_GOOGLE_MAPS_API_KEY=your-browser-api-key


# --- Local Supabase Auth (Google) — not VITE_*; not bundled to the browser ----------
# Loaded by scripts/dev/run-with-ui-dev-env.sh before `supabase start` so GoTrue gets
# OAuth credentials (supabase/config.toml [auth.external.google]).
# Google Cloud → OAuth Web client → Authorized redirect URIs:
#   http://127.0.0.1:54321/auth/v1/callback
#   http://localhost:54321/auth/v1/callback
# Do not use SUPABASE_ prefix for these (CLI may skip those env names).
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret

# --- Legacy / optional ----------------------------------------------------
# Historically committed for local Supabase CLI convenience. Not read by the app.
# VITE_SUPABASE_DB_PASSWORD=replace-me

# --- Guest Inbox mock preview (optional) -----------------------------------
# When true, inbox uses in-memory mock data instead of edge functions.
# Prefer live mode for E2E testing; enable mock only for UI work without Meta.
# VITE_INBOX_MOCK_DATA=true
